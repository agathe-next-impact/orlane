---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page non trouvée">
  <section class="bg-gradient-to-br from-surface to-canvas min-h-[60vh] flex items-center justify-center">
    <div class="text-center px-4">
      <h1 class="text-6xl font-bold accent-text opacity-30 mb-3 font-heading">404</h1>
      <h2 class="text-2xl font-bold text-ink mb-3 font-heading">Page non trouvée</h2>
      <p class="text-base text-ink/70 mb-6 max-w-md mx-auto">
        La page que vous cherchez n'existe pas ou a été déplacée.
      </p>
      <a href="/" class="inline-block accent-bg text-canvas px-5 py-3 rounded-lg text-sm font-semibold accent-bg-hover transition-colors">
        Retour à l'accueil
      </a>
    </div>
  </section>
</Layout>
