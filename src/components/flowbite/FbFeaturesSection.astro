---
import type { WPACFFbFeaturesSection } from '../../types/wp';
import { Icon } from 'astro-icon/components';

interface Props extends WPACFFbFeaturesSection {}

const {
  heading,
  description,
  headerImage,
  items = [],
  columns = '3',
  variant = 'default',
  image,
  ctaText,
  ctaUrl,
} = Astro.props;

const gridClass: Record<string, string> = {
  '2': 'md:grid-cols-2',
  '3': 'md:grid-cols-2 lg:grid-cols-3',
  '4': 'md:grid-cols-2 lg:grid-cols-4',
};

const isDark = variant === 'dark';
const bgClass = isDark ? 'bg-ink text-canvas' : 'bg-[var(--block-bg,transparent)]';
const titleClass = isDark ? 'text-canvas' : 'text-ink';
const textClass = isDark ? 'text-canvas/70' : 'text-ink/70';
const itemClass = isDark ? 'bg-ink/80' : 'feature-card';
---

{/* ── Block CTA helper (rendered at end of each variant) ── */}

{/* ── 1. Grille de cartes ── */}
{variant === 'default' && (
  <section class={bgClass}>
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-24 lg:px-6">
      {(heading || description || headerImage) && (
        <div class={`mb-8 lg:mb-12 ${headerImage ? 'flex flex-col md:flex-row md:items-center md:gap-12' : ''}`}>
          <div class={headerImage ? 'flex-1' : 'max-w-screen-md'}>
            {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
            {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
          </div>
          {headerImage && (
            <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="mt-6 md:mt-0 w-full md:w-1/3 max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg" />
          )}
        </div>
      )}
      <div class={`space-y-8 md:grid ${gridClass[columns] || gridClass['3']} md:gap-12 md:space-y-0`}>
        {items.map((item) => (
          <div class={`p-6 rounded-2xl shadow-lg ${itemClass}`}>
            {item.image ? (
              <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="w-1/2 aspect-[4/3] object-cover rounded-lg mb-5" />
            ) : item.icon ? (
              <Icon name={`lucide:${item.icon}`} class="w-12 h-12 mb-5 accent-text" />
            ) : null}
            {item.title && <h3 class={`mb-2 text-xl font-bold ${titleClass}`}>{item.title}</h3>}
            {item.subtitle && <p class={`mb-1 text-lg font-medium ${textClass}`}>{item.subtitle}</p>}
            <div class="h-4 w-1/2 mt-4 border-t-2 accent-border"></div>
            {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
            {item.ctaText && item.ctaUrl && (
              <a href={item.ctaUrl} class="btn-primary mt-4 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
            )}
          </div>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="mt-12 text-center">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
        </div>
      )}
    </div>
  </section>
)}

{/* ── 8. Cartes + image de section ── */}
{variant === 'image_right' && (
  <section class={bgClass}>
    <div class="gap-8 items-center py-16 px-4 mx-auto max-w-screen-xl xl:gap-16 sm:py-24 lg:px-6">
      <div>
        <div class={`mb-8 ${headerImage ? 'flex flex-col md:flex-row md:items-center md:gap-12' : ''}`}>
          <div class={headerImage ? 'flex-1' : ''}>
            {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
            {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
          </div>
          {headerImage && (
            <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="mt-6 md:mt-0 w-full md:w-1/3 max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg" />
          )}
        </div>
        <div class={`space-y-6 grid ${gridClass[columns] || gridClass['3']} md:gap-12 md:space-y-0`}>
          {items.map((item) => (
            <div class={`w-full flex gap-4 p-4 rounded-2xl shadow-lg ${itemClass}`}>
              {item.image ? (
                <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="flex-shrink-0 w-48 h-full object-cover rounded-lg" />
              ) : item.icon ? (
                <Icon name={`lucide:${item.icon}`} class="flex-shrink-0 w-8 h-8 accent-text" />
              ) : null}
              <div>
                {item.title && <h3 class={`mb-1 text-lg font-bold ${titleClass}`}>{item.title}</h3>}
                {item.subtitle && <p class={`mb-1 text-lg font-medium ${textClass}`}>{item.subtitle}</p>}
                <div class="h-4 w-1/2 mt-4 border-t-2 accent-border"></div>
                {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
                {item.ctaText && item.ctaUrl && (
                  <a href={item.ctaUrl} class="btn-primary mt-4 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
      {image && (
        <img class="w-full rounded-lg shadow-xl object-cover aspect-[4/3]" src={image.sourceUrl} alt={image.altText || ''} width={image.mediaDetails?.width} height={image.mediaDetails?.height} />
      )}
      {ctaText && ctaUrl && (
        <div class="mt-12 text-center">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
        </div>
      )}
    </div>
  </section>
)}

{/* ── 2. Cartes avec liens ── */}
{variant === 'with_ctas' && (
  <section class={bgClass}>
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-24 lg:px-6">
      {(heading || description || headerImage) && (
        <div class={`mb-8 lg:mb-12 ${headerImage ? 'flex flex-col md:flex-row md:items-center md:gap-12' : ''}`}>
          <div class={headerImage ? 'flex-1' : 'max-w-screen-md'}>
            {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
            {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
          </div>
          {headerImage && (
            <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="mt-6 md:mt-0 w-full md:w-1/3 max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg" />
          )}
        </div>
      )}
      <div class={`space-y-8 md:grid ${gridClass[columns] || gridClass['3']} md:gap-12 md:space-y-0`}>
        {items.map((item) => (
          <div class={`p-6 rounded-2xl shadow-lg ${itemClass}`}>
            {item.image ? (
              <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="w-full aspect-[4/3] object-cover rounded-lg mb-5" />
            ) : item.icon ? (
              <Icon name={`lucide:${item.icon}`} class="w-12 h-12 mb-5 accent-text" />
            ) : null}
            {item.title && <h3 class={`mb-2 text-xl font-bold ${titleClass}`}>{item.title}</h3>}
            {item.subtitle && <p class={`mb-1 text-lg font-medium ${textClass}`}>{item.subtitle}</p>}
            {item.description && <div class={`prose prose-sm max-w-none mt-6 mb-3 ${textClass}`} set:html={item.description} />}
            {item.ctaText && item.ctaUrl ? (
              <a href={item.ctaUrl} class="btn-primary mt-4 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
            ) : item.link && (
              <a href={item.link} class="inline-flex items-center accent-text hover:opacity-80 font-medium transition-colors">
                En savoir plus
                <svg class="ml-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
              </a>
            )}
          </div>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="mt-12 text-center">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
        </div>
      )}
    </div>
  </section>
)}

{/* ── 3. Cartes avec bouton ── */}
{variant === 'icons_cta' && (
  <section class={bgClass}>
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-24 lg:px-6">
      {(heading || description || headerImage) && (
        <div class={`mb-8 lg:mb-12 ${headerImage ? 'flex flex-col md:flex-row md:items-center md:gap-12' : ''}`}>
          <div class={headerImage ? 'flex-1' : 'max-w-screen-md'}>
            {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
            {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
          </div>
          {headerImage && (
            <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="mt-6 md:mt-0 w-full md:w-1/3 max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg" />
          )}
        </div>
      )}
      <div class={`space-y-8 md:grid ${gridClass[columns] || gridClass['3']} md:gap-16 md:space-y-0`}>
        {items.map((item) => (
          <div class={`flex flex-col items-start p-6 rounded-lg ${itemClass}`}>
            {item.image ? (
              <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="w-full aspect-[3/2] object-cover rounded-lg mb-5" />
            ) : item.icon ? (
              <Icon name={`lucide:${item.icon}`} class="w-12 h-12 mb-5 accent-text" />
            ) : null}
            {item.title && <h3 class={`mb-2 text-2xl font-bold ${titleClass}`}>{item.title}</h3>}
            {item.subtitle && <p class={`mb-1 text-sm font-medium ${textClass}`}>{item.subtitle}</p>}
            {item.description && <div class={`prose prose-sm max-w-none mb-4 ${textClass}`} set:html={item.description} />}
            {item.ctaText && item.ctaUrl && (
              <a href={item.ctaUrl} class="btn-primary mt-4 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
            )}
          </div>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="mt-12 text-center">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
        </div>
      )}
    </div>
  </section>
)}

{/* ── 9. Texte à gauche + liste ── */}
{variant === 'split_description' && (
  <section class={bgClass}>
    <div class="gap-16 items-start py-16 px-4 mx-auto max-w-screen-xl sm:py-24 lg:px-6 md:grid md:grid-cols-2">
      <div class="md:sticky md:top-24 md:max-h-[calc(100vh-8rem)] md:overflow-y-auto">
        {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
        {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
        {ctaText && ctaUrl && (
          <a href={ctaUrl} class="btn-primary mt-6 text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
        )}
        {headerImage && (
          <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="w-full max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg mb-6 mt-20" />
        )}
      </div>
      <div class="grid gap-8 mt-8 md:mt-0">
        {items.map((item) => (
          <div class={`flex gap-4 p-4 rounded-lg ${itemClass}`}>
            {item.image ? (
              <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="flex-shrink-0 w-14 h-14 object-cover rounded-lg" />
            ) : item.icon ? (
              <Icon name={`lucide:${item.icon}`} class="flex-shrink-0 w-8 h-8 accent-text" />
            ) : null}
            <div>
              {item.title && <h3 class={`mb-1 text-lg font-bold ${titleClass}`}>{item.title}</h3>}
              {item.subtitle && <p class={`mb-1 text-sm font-medium ${textClass}`}>{item.subtitle}</p>}
              <div class="h-4 w-1/2 mt-4 border-t-2 accent-border"></div>
              {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
              {item.ctaText && item.ctaUrl && (
                <a href={item.ctaUrl} class="btn-primary mt-4 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{/* ── 10. Image et liste en alternance ── */}
{variant === 'alternating' && (
  <section class={bgClass}>
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-24 lg:px-6">
      {(heading || description || headerImage) && (
        <div class={`mb-8 lg:mb-12 ${headerImage ? 'flex flex-col md:flex-row md:items-center md:gap-12' : ''}`}>
          <div class={headerImage ? 'flex-1' : 'max-w-screen-md'}>
            {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
            {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
          </div>
          {headerImage && (
            <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="mt-6 md:mt-0 w-full md:w-1/3 max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg" />
          )}
        </div>
      )}
      <div class="space-y-16">
        {image && (
          <div class="gap-8 md:grid md:grid-cols-2 xl:gap-16">
            <img class="w-full rounded-lg shadow-xl object-cover aspect-[4/3]" src={image.sourceUrl} alt={image.altText || ''} width={image.mediaDetails?.width} height={image.mediaDetails?.height} />
            <div class="mt-8 md:mt-0 space-y-6">
              {items.slice(0, Math.ceil(items.length / 2)).map((item) => (
                <div class={`flex gap-4 p-4 rounded-lg ${itemClass}`}>
                  {item.image ? (
                    <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="flex-shrink-0 w-14 h-14 object-cover rounded-lg" />
                  ) : item.icon ? (
                    <Icon name={`lucide:${item.icon}`} class="flex-shrink-0 w-8 h-8 accent-text" />
                  ) : null}
                  <div>
                    {item.title && <h3 class={`mb-1 text-lg font-bold ${titleClass}`}>{item.title}</h3>}
                    {item.subtitle && <p class={`mb-1 text-lg font-medium ${textClass}`}>{item.subtitle}</p>}
                    {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
                    {item.ctaText && item.ctaUrl && (
                      <a href={item.ctaUrl} class="btn-primary mt-3 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
        {image && items.length > Math.ceil(items.length / 2) && (
          <div class="gap-8 items-center md:grid md:grid-cols-2 xl:gap-16">
            <div class="space-y-6 md:order-1">
              {items.slice(Math.ceil(items.length / 2)).map((item) => (
                <div class={`flex gap-4 p-4 rounded-lg ${itemClass}`}>
                  {item.image ? (
                    <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="flex-shrink-0 w-14 h-14 object-cover rounded-lg" />
                  ) : item.icon ? (
                    <Icon name={`lucide:${item.icon}`} class="flex-shrink-0 w-8 h-8 accent-text" />
                  ) : null}
                  <div>
                    {item.title && <h3 class={`mb-1 text-lg font-bold ${titleClass}`}>{item.title}</h3>}
                    {item.subtitle && <p class={`mb-1 text-lg font-medium ${textClass}`}>{item.subtitle}</p>}
                    {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
                    {item.ctaText && item.ctaUrl && (
                      <a href={item.ctaUrl} class="btn-primary mt-3 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
                    )}
                  </div>
                </div>
              ))}
            </div>
            <img class="w-full rounded-lg shadow-xl object-cover aspect-[4/3] md:order-2" src={image.sourceUrl} alt={image.altText || ''} width={image.mediaDetails?.width} height={image.mediaDetails?.height} />
          </div>
        )}
        {!image && (
          <div class={`space-y-8 md:grid ${gridClass[columns] || gridClass['3']} md:gap-12 md:space-y-0`}>
            {items.map((item) => (
              <div class={`flex gap-4 p-4 rounded-lg ${itemClass}`}>
                {item.image ? (
                  <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="flex-shrink-0 w-14 h-14 object-cover rounded-lg" />
                ) : item.icon ? (
                  <Icon name={`lucide:${item.icon}`} class="flex-shrink-0 w-8 h-8 accent-text" />
                ) : null}
                <div>
                  {item.title && <h3 class={`mb-1 text-lg font-bold ${titleClass}`}>{item.title}</h3>}
                  {item.subtitle && <p class={`mb-1 text-sm font-medium ${textClass}`}>{item.subtitle}</p>}
                  {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
                  {item.ctaText && item.ctaUrl && (
                    <a href={item.ctaUrl} class="btn-primary mt-3 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
      {ctaText && ctaUrl && (
        <div class="mt-12 text-center">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
        </div>
      )}
    </div>
  </section>
)}

{/* ── 4. Cartes avec icônes rondes ── */}
{variant === 'rounded_icons' && (
  <section class={bgClass}>
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-24 lg:px-6">
      {(heading || description || headerImage) && (
        <div class={`mb-8 lg:mb-12 ${headerImage ? 'flex flex-col md:flex-row md:items-center md:gap-12' : ''}`}>
          <div class={headerImage ? 'flex-1' : 'max-w-screen-md'}>
            {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
            {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
          </div>
          {headerImage && (
            <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="mt-6 md:mt-0 w-full md:w-1/3 max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg" />
          )}
        </div>
      )}
      <div class={`space-y-8 md:grid ${gridClass[columns] || gridClass['3']} md:gap-12 md:space-y-0`}>
        {items.map((item) => (
          <div class={`p-6 rounded-lg ${itemClass}`}>
            {item.image ? (
              <img src={item.image.sourceUrl} alt={item.image.altText || ''} class="w-full aspect-square object-cover rounded-full mx-auto mb-5 max-w-[8rem]" />
            ) : item.icon ? (
              <div class="flex items-center justify-center w-20 h-20 mx-auto mb-5 rounded-full accent-bg-soft">
                <Icon name={`lucide:${item.icon}`} class="w-10 h-10 accent-text" />
              </div>
            ) : null}
            {item.title && <h3 class={`mb-2 text-xl font-bold ${titleClass}`}>{item.title}</h3>}
            {item.subtitle && <p class={`mb-1 text-lg font-medium ${textClass}`}>{item.subtitle}</p>}
            <div class="h-4 w-1/2 mt-4 border-t-2 accent-border"></div>
            {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
            {item.ctaText && item.ctaUrl && (
              <a href={item.ctaUrl} class="btn-primary mt-4 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
            )}
          </div>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="mt-12 text-center">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
        </div>
      )}
    </div>
  </section>
)}

{/* ── 5. Étapes numérotées ── */}
{variant === 'numbered' && (
  <section class={bgClass}>
    <div class="py-16 px-4 mx-auto max-w-screen-xl sm:py-24 lg:px-6">
      {(heading || description || headerImage) && (
        <div class={`mb-8 lg:mb-12 ${headerImage ? 'flex flex-col md:flex-row md:items-center md:gap-12' : ''}`}>
          <div class={headerImage ? 'flex-1' : 'max-w-screen-md'}>
            {heading && <h2 class={`mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold font-heading ${titleClass}`}>{heading}</h2>}
            {description && <p class={`sm:text-lg ${textClass}`}>{description}</p>}
          </div>
          {headerImage && (
            <img src={headerImage.sourceUrl} alt={headerImage.altText || ''} class="mt-6 md:mt-0 w-full md:w-1/3 max-w-xs rounded-2xl object-cover aspect-[4/3] shadow-lg" />
          )}
        </div>
      )}
      <div class={`space-y-8 md:grid ${gridClass[columns] || gridClass['3']} md:gap-12 md:space-y-0`}>
        {items.map((item, i) => (
          <div class={`relative p-6 rounded-lg ${itemClass}`}>
            <span class="flex justify-center items-center mb-4 w-10 h-10 rounded-full accent-bg text-canvas text-lg font-bold">
              {i + 1}
            </span>
            {item.title && <h3 class={`mb-2 text-xl font-bold ${titleClass}`}>{item.title}</h3>}
            {item.subtitle && <p class={`mb-1 text-sm font-medium ${textClass}`}>{item.subtitle}</p>}
            {item.description && <div class={`prose prose-sm max-w-none ${textClass}`} set:html={item.description} />}
            {item.ctaText && item.ctaUrl && (
              <a href={item.ctaUrl} class="btn-primary mt-4 text-sm text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{item.ctaText}</a>
            )}
