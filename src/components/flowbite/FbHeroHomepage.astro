---
import { linkAttrs } from '../../lib/link-attrs';
import type { WPACFFbHeroHomepage } from '../../types/wp';
import AnimatedHeartSVG from '../AnimatedHeartSVG.astro';

interface Props extends WPACFFbHeroHomepage {}

const { heading, highlight, subtitle, ctaText, ctaUrl, cta2Text, cta2Url, ctaUrlTarget, cta2UrlTarget, images = [], showHeartAnimation = true } = Astro.props;
---

<section class="relative h-[calc(100vh-4rem)] w-fullhero bg-gradient-to-br from-surface py-6 to-canvas overflow-hidden">
  {showHeartAnimation && (
    <div class="absolute bottom-8 left-0 w-full max-w-4xl pointer-events-none">
      <AnimatedHeartSVG />
    </div>
  )}
  <div class="h-full px-4 relative z-10 max-w-screen-xl mx-auto">
    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      <div class="max-w-3xl pt-20">
        {heading && (
          <h1 class="text-4xl md:text-5xl font-bold mb-6 font-heading tracking-tight leading-none">
            {highlight ? (
              <>
                <div class="text-ink">{heading}</div>
                <div class="mt-2 text-ink/60">{highlight}</div>
              </>
            ) : (
              <span class="text-ink">{heading}</span>
            )}
          </h1>
        )}
        {subtitle && (
          <p class="text-lg md:text-xl mb-8 text-ink">{subtitle}</p>
        )}
        <div class="flex flex-wrap gap-4">
          {ctaText && ctaUrl && (
            <a href={ctaUrl} {...linkAttrs(ctaUrlTarget)} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 accent-ring">{ctaText}</a>
          )}
          {cta2Text && cta2Url && (
            <a href={cta2Url} {...linkAttrs(cta2UrlTarget)} class="btn-secondary accent-text focus:ring-4 accent-ring">{cta2Text}</a>
          )}
        </div>
      </div>
      {images.length > 0 && (
        <div class="columns-2 gap-3 space-y-3 content-end">
          {images.map((img) => (
            <img
              src={img.sourceUrl}
              alt={img.altText || ''}
              width={img.mediaDetails?.width}
              height={img.mediaDetails?.height}
              class="rounded-2xl shadow-lg w-full object-contain"
            />
          ))}
        </div>
      )}
    </div>
  </div>
</section>
