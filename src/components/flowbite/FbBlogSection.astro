---
import { sanitizeHTML } from '../../lib/utils/sanitize';
import type { WPACFFbBlogSection } from '../../types/wp';

interface Props extends WPACFFbBlogSection {}

const { heading, description, posts = [], variant = 'cards', ctaText, ctaUrl } = Astro.props;
---

{variant === 'cards' && (
  <section class="bg-canvas">
    <div class="py-16 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
      {(heading || description) && (
        <div class="mx-auto max-w-screen-sm text-center lg:mb-12 mb-8">
          {heading && (
            <h2 class="mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold text-ink font-heading">
              {heading}
            </h2>
          )}
          {description && (
            <p class="font-light text-ink/70 sm:text-lg">
              {description}
            </p>
          )}
        </div>
      )}
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="p-6 bg-surface/20 rounded-lg border border-surface shadow-sm hover:shadow-md transition-shadow">
            {post.image && (
              <a href={post.url || '#'}>
                <img class="mb-5 rounded-lg w-full h-48 object-cover" src={post.image.sourceUrl} alt={post.image.altText || post.title || ''} loading="lazy" />
              </a>
            )}
            {post.category && (
              <span class="accent-bg-soft accent-text text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded mb-3">
                {post.category}
              </span>
            )}
            {post.title && (
              <h3 class="mb-2 text-2xl font-bold tracking-tight text-ink">
                <a href={post.url || '#'} class="accent-text-hover transition-colors">{post.title}</a>
              </h3>
            )}
            {post.excerpt && (
              <p class="mb-4 font-light text-ink/70">{post.excerpt}</p>
            )}
            <div class="flex justify-between items-center">
              {post.author && (
                <div class="flex items-center space-x-3">
                  {post.authorAvatar && (
                    <img class="w-7 h-7 rounded-full object-cover" src={post.authorAvatar.sourceUrl} alt={post.author} />
                  )}
                  <span class="text-sm font-medium text-ink">{post.author}</span>
                </div>
              )}
              {post.date && (
                <span class="text-sm text-ink/60">{post.date}</span>
              )}
            </div>
          </article>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="text-center mt-12">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 focus:outline-none accent-ring">
            {ctaText}
            <svg class="w-5 h-5 ms-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </a>
        </div>
      )}
    </div>
  </section>
)}

{variant === 'list' && (
  <section class="bg-canvas">
    <div class="py-16 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
      {(heading || description) && (
        <div class="mx-auto max-w-screen-sm text-center lg:mb-12 mb-8">
          {heading && (
            <h2 class="mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold text-ink font-heading">{heading}</h2>
          )}
          {description && (
            <p class="font-light text-ink/70 sm:text-lg">{description}</p>
          )}
        </div>
      )}
      <div class="space-y-8 max-w-screen-md mx-auto">
        {posts.map((post) => (
          <article class="flex gap-6 items-start">
            {post.image && (
              <a href={post.url || '#'} class="flex-shrink-0">
                <img class="w-32 h-24 rounded-lg object-cover" src={post.image.sourceUrl} alt={post.image.altText || post.title || ''} loading="lazy" />
              </a>
            )}
            <div>
              {post.category && (
                <span class="text-xs font-medium accent-text uppercase">{post.category}</span>
              )}
              {post.title && (
                <h3 class="mb-1 text-xl font-bold text-ink">
                  <a href={post.url || '#'} class="accent-text-hover transition-colors">{post.title}</a>
                </h3>
              )}
              {post.excerpt && (
                <p class="font-light text-ink/70 text-sm">{post.excerpt}</p>
              )}
              <div class="flex items-center gap-3 mt-2 text-sm text-ink/60">
                {post.author && <span>{post.author}</span>}
                {post.date && <span>{post.date}</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="text-center mt-12">
          <a href={ctaUrl} class="inline-flex items-center accent-text accent-text-hover font-medium transition-colors">
            {ctaText}
            <svg class="w-5 h-5 ms-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </a>
        </div>
      )}
    </div>
  </section>
)}

{variant === 'centered' && (
  <section class="bg-canvas">
    <div class="py-16 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
      {(heading || description) && (
        <div class="mx-auto max-w-screen-sm text-center lg:mb-12 mb-8">
          {heading && (
            <h2 class="mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold text-ink font-heading">{heading}</h2>
          )}
          {description && (
            <p class="font-light text-ink/70 sm:text-lg">{description}</p>
          )}
        </div>
      )}
      <div class="space-y-12 max-w-screen-md mx-auto">
        {posts.map((post) => (
          <article class="text-center">
            {post.category && (
              <span class="accent-bg-soft accent-text text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded mb-3">
                {post.category}
              </span>
            )}
            {post.title && (
              <h3 class="mb-2 text-2xl font-bold tracking-tight text-ink">
                <a href={post.url || '#'} class="accent-text-hover transition-colors">{post.title}</a>
              </h3>
            )}
            {post.excerpt && (
              <p class="mb-4 font-light text-ink/70 max-w-lg mx-auto">{post.excerpt}</p>
            )}
            <div class="flex justify-center items-center gap-4 text-sm text-ink/60">
              {post.author && (
                <div class="flex items-center gap-2">
                  {post.authorAvatar && (
                    <img class="w-6 h-6 rounded-full object-cover" src={post.authorAvatar.sourceUrl} alt={post.author} />
                  )}
                  <span class="font-medium text-ink">{post.author}</span>
                </div>
              )}
              {post.date && <span>{post.date}</span>}
            </div>
          </article>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="text-center mt-12">
          <a href={ctaUrl} class="inline-flex items-center accent-text accent-text-hover font-medium transition-colors">
            {ctaText}
            <svg class="w-5 h-5 ms-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </a>
        </div>
      )}
    </div>
  </section>
)}

{variant === 'cards_image' && (
  <section class="bg-canvas">
    <div class="py-16 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
      {(heading || description) && (
        <div class="mx-auto max-w-screen-sm text-center lg:mb-12 mb-8">
          {heading && (
            <h2 class="mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold text-ink font-heading">{heading}</h2>
          )}
          {description && (
            <p class="font-light text-ink/70 sm:text-lg">{description}</p>
          )}
        </div>
      )}
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="bg-surface/20 rounded-lg border border-surface shadow-sm overflow-hidden">
            {post.image && (
              <a href={post.url || '#'}>
                <img class="w-full h-48 object-cover" src={post.image.sourceUrl} alt={post.image.altText || post.title || ''} loading="lazy" />
              </a>
            )}
            <div class="p-5">
              {post.category && (
                <span class="accent-bg-soft accent-text text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded mb-3">
                  {post.category}
                </span>
              )}
              {post.title && (
                <h3 class="mb-2 text-xl font-bold tracking-tight text-ink">
                  <a href={post.url || '#'} class="accent-text-hover transition-colors">{post.title}</a>
                </h3>
              )}
              {post.excerpt && (
                <p class="mb-4 text-sm font-light text-ink/70">{post.excerpt}</p>
              )}
              <div class="flex items-center justify-between">
                {post.author && (
                  <div class="flex items-center gap-2">
                    {post.authorAvatar && (
                      <img class="w-8 h-8 rounded-full object-cover" src={post.authorAvatar.sourceUrl} alt={post.author} />
                    )}
                    <div>
                      <p class="text-sm font-medium text-ink">{post.author}</p>
                      {post.date && <p class="text-xs text-ink/60">{post.date}</p>}
                    </div>
                  </div>
                )}
                <a href={post.url || '#'} class="inline-flex items-center text-sm font-medium accent-text accent-text-hover transition-colors">
                  Lire
                  <svg class="w-4 h-4 ms-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
      {ctaText && ctaUrl && (
        <div class="text-center mt-12">
          <a href={ctaUrl} class="btn-primary text-canvas accent-bg accent-bg-hover focus:ring-4 focus:outline-none accent-ring">
            {ctaText}
            <svg class="w-5 h-5 ms-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </a>
        </div>
      )}
    </div>
  </section>
)}

{variant === 'featured' && (
  <section class="bg-canvas">
    <div class="py-16 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
      {heading && (
        <h2 class="mb-8 text-3xl lg:text-4xl tracking-tight font-extrabold text-ink font-heading">{heading}</h2>
      )}
      {posts.length > 0 && (
        <div class="grid gap-8 lg:grid-cols-2">
          <article class="relative">
            {posts[0].image && (
              <img class="w-full h-48 object-cover rounded-lg" src={posts[0].image.sourceUrl} alt={posts[0].image.altText || posts[0].title || ''} />
            )}
            <div class="mt-4">
              {posts[0].category && (
                <span class="accent-bg-soft accent-text text-xs font-medium px-2.5 py-0.5 rounded">{posts[0].category}</span>
              )}
              <h3 class="mt-2 text-2xl font-bold text-ink">
                <a href={posts[0].url || '#'} class="accent-text-hover transition-colors">{posts[0].title}</a>
              </h3>
              {posts[0].excerpt && (
                <p class="mt-2 text-ink/70">{posts[0].excerpt}</p>
              )}
            </div>
          </article>
          <div class="space-y-6">
            {posts.slice(1).map((post) => (
              <article class="flex gap-4 items-start">
                {post.image && (
                  <img class="w-24 h-20 rounded-lg object-cover flex-shrink-0" src={post.image.sourceUrl} alt={post.image.altText || post.title || ''} loading="lazy" />
                )}
                <div>
                  {post.category && (
                    <span class="text-xs font-medium accent-text">{post.category}</span>
                  )}
                  <h3 class="text-lg font-bold text-ink">
                    <a href={post.url || '#'} class="accent-text-hover transition-colors">{post.title}</a>
                  </h3>
                  {post.date && <span class="text-sm text-ink/60">{post.date}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
